generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  UZCARD
  HUMO
  CASH
  DEPOSIT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum DebtType {
  OWES_ME
  I_OWE
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum BudgetStatus {
  NORMAL
  WARNING
  EXCEEDED
}

enum NotificationType {
  DEBT
  BUDGET
  INSIGHT
  SYSTEM
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  phone                String?                @unique @db.VarChar(32)
  fullName             String                 @db.VarChar(120)
  email                String?                @unique @db.VarChar(254)
  passwordHash         String?                @map("password_hash") @db.VarChar(255)
  avatarUrl            String?                @map("avatar_url") @db.VarChar(2048)
  currency             String                 @default("UZS") @db.Char(3)
  language             String                 @default("uz") @db.VarChar(10)
  phoneVerifiedAt      DateTime?              @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt      DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  pinEnabled           Boolean                @default(false) @map("pin_enabled")
  biometricEnabled     Boolean                @default(false) @map("biometric_enabled")
  lastLoginAt          DateTime?              @map("last_login_at") @db.Timestamptz(6)
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions             Session[]
  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  budgets              Budget[]
  notifications        Notification[]
  devices              Device[]
  subscription         Subscription?
  recurringTransactions RecurringTransaction[]
  attachments          Attachment[]
  auditLogs            AuditLog[]

  @@map("wealth_users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  deviceName        String?   @map("device_name") @db.VarChar(120)
  deviceId          String?   @map("device_id") @db.VarChar(200)
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("wealth_sessions")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String        @db.VarChar(100)
  type         AccountType
  mask         String?       @db.VarChar(32)
  balance      Decimal       @default(0) @db.Decimal(18, 2)
  currency     String        @default("UZS") @db.Char(3)
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("SourceAccount")
  transfersIn  Transaction[] @relation("DestinationAccount")
  ledgerEntries LedgerEntry[]
  debtPayments DebtPayment[]
  recurring    RecurringTransaction[]

  @@index([userId, createdAt])
  @@map("wealth_accounts")
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String?         @map("user_id") @db.Uuid
  name         String          @db.VarChar(100)
  type         CategoryType
  icon         String?         @db.VarChar(80)
  color        String?         @db.VarChar(16)
  isSystem     Boolean         @default(false) @map("is_system")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgetLimits BudgetCategory[]
  recurring    RecurringTransaction[]

  @@unique([userId, type, name])
  @@index([type, isSystem])
  @@map("wealth_categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  toAccountId     String?         @map("to_account_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(18, 2)
  currency        String          @default("UZS") @db.Char(3)
  description     String          @default("") @db.VarChar(500)
  transactionDate DateTime        @default(now()) @map("transaction_date") @db.Timestamptz(6)
  receiptUrl      String?         @map("receipt_url") @db.VarChar(2048)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account         @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount       Account?        @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]
  debtPayment     DebtPayment?
  attachments     Attachment[]

  @@index([userId, transactionDate(sort: Desc)])
  @@index([userId, type, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId, transactionDate])
  @@map("wealth_transactions")
}

model LedgerEntry {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  accountId     String      @map("account_id") @db.Uuid
  amount        Decimal     @db.Decimal(18, 2)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("wealth_ledger_entries")
}

model Debt {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  personName       String        @map("person_name") @db.VarChar(120)
  phone            String?       @db.VarChar(32)
  relationship     String?       @db.VarChar(80)
  type             DebtType
  totalAmount      Decimal       @map("total_amount") @db.Decimal(18, 2)
  paidAmount       Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  remainingAmount  Decimal       @map("remaining_amount") @db.Decimal(18, 2)
  dueDate          DateTime?     @map("due_date") @db.Date
  status           DebtStatus    @default(PENDING)
  notes            String?       @db.VarChar(2000)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments         DebtPayment[]

  @@index([userId, dueDate, status])
  @@map("wealth_debts")
}

model DebtPayment {
  id            String       @id @default(uuid()) @db.Uuid
  debtId        String       @map("debt_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  accountId     String       @map("account_id") @db.Uuid
  amount        Decimal      @db.Decimal(18, 2)
  paymentDate   DateTime     @default(now()) @map("payment_date") @db.Timestamptz(6)
  note          String?      @db.VarChar(500)
  transactionId String?      @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  debt          Debt         @relation(fields: [debtId], references: [id], onDelete: Restrict)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate])
  @@index([debtId, paymentDate])
  @@map("wealth_debt_payments")
}

model Budget {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  month      Int
  year       Int
  totalLimit Decimal          @map("total_limit") @db.Decimal(18, 2)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("wealth_budgets")
}

model BudgetCategory {
  id         String   @id @default(uuid()) @db.Uuid
  budgetId   String   @map("budget_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  limit      Decimal  @db.Decimal(18, 2)
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@map("wealth_budget_categories")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(160)
  message        String           @db.VarChar(2000)
  isRead         Boolean          @default(false) @map("is_read")
  deepLink       String?          @map("deep_link") @db.VarChar(500)
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("wealth_notifications")
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  deviceId  String         @map("device_id") @db.VarChar(200)
  fcmToken  String         @unique @map("fcm_token") @db.VarChar(4096)
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("wealth_devices")
}

model Plan {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String         @unique @db.VarChar(32)
  name                 String         @db.VarChar(80)
  maxAccounts          Int?
  advancedInsights     Boolean        @default(false) @map("advanced_insights")
  pdfExport            Boolean        @default(false) @map("pdf_export")
  xlsxExport           Boolean        @default(false) @map("xlsx_export")
  recurringTransactions Boolean       @default(false) @map("recurring_transactions")
  debtCollaboration    Boolean        @default(false) @map("debt_collaboration")
  subscriptions        Subscription[]

  @@map("wealth_plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @map("user_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("wealth_subscriptions")
}

model RecurringTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  accountId   String              @map("account_id") @db.Uuid
  categoryId  String?             @map("category_id") @db.Uuid
  type        TransactionType
  amount      Decimal             @db.Decimal(18, 2)
  currency    String              @default("UZS") @db.Char(3)
  description String              @default("") @db.VarChar(500)
  frequency   RecurrenceFrequency
  nextRunAt   DateTime            @map("next_run_at") @db.Timestamptz(6)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([isActive, nextRunAt])
  @@map("wealth_recurring_transactions")
}

model Attachment {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  transactionId String       @map("transaction_id") @db.Uuid
  storageKey    String       @unique @map("storage_key") @db.VarChar(1024)
  mimeType      String       @map("mime_type") @db.VarChar(100)
  sizeBytes     Int          @map("size_bytes")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, transactionId])
  @@map("wealth_attachments")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("wealth_audit_logs")
}